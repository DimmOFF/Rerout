// Resources of rerout.exe: the icon shown by Explorer / taskbar / Alt+Tab,
// and version information (shown in Task Manager and the file properties).

1 ICON "rerout.ico"

1 VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEOS 0x4L
 FILETYPE 0x1L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Rerout - per-application network interface control"
            VALUE "ProductName", "Rerout"
            VALUE "FileVersion", "0.1.0"
            VALUE "ProductVersion", "0.1.0"
            VALUE "InternalName", "rerout"
            VALUE "OriginalFilename", "rerout.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
